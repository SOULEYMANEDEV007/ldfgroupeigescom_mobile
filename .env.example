# ── LdF Igescom Mobile — Modèle de Variables d'Environnement ──────────────────
# Copier ce fichier en '.env' et renseigner les vraies valeurs locales.

# Configuration API (serveur IGESCOM — SANS slash final, sans préfixe /api)
# Les chemins complets (/api/...) sont définis dans ApiEndpoints.
API_BASE_URL=http://192.168.1.238
CONNECT_TIMEOUT=15000
RECEIVE_TIMEOUT=15000

# true  = données simulées (mode démo, aucune requête réseau pour les features mockées)
# false = vraie API backend
USE_MOCK_API=false

# Environnement de l'application (development, staging, production)
APP_ENV=development
APP_NAME=IGESCOM Mobile
